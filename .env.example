NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seedlingsmicrogreenwebsite
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Demo OTP is development/test only. Keep disabled in production.
NEXT_PUBLIC_ENABLE_DEMO_OTP=false
# Set only in a local development/test environment when demo OTP is enabled.
# NEXT_PUBLIC_DEMO_OTP=1234

# Cashfree Payment Gateway browser SDK mode only.
NEXT_PUBLIC_CASHFREE_ENVIRONMENT=sandbox

# Cashfree server-only variables (never expose in NEXT_PUBLIC_*).
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2025-01-01
# Optional. If not set, request origin is used to build return URL.
# CASHFREE_SITE_URL=http://localhost:3000

# Server-side Firebase Admin credentials (choose one mode below).
# Option 1: Entire service-account JSON in one variable.
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
# Option 2: Split credentials.
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seedlingsmicrogreenwebsite
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Demo OTP is development/test only. Keep disabled in production.

# Cashfree Payment Gateway browser SDK mode only.
# Cashfree server credentials are stored in Firebase Functions Secret Manager.
NEXT_PUBLIC_CASHFREE_ENVIRONMENT=sandbox

# Cashfree server-side configuration (required by Next.js Route Handlers).
# Do not expose these values through NEXT_PUBLIC_* variables.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2025-01-01
CASHFREE_SITE_URL=

# Independent delivery-partner browser session signing secret
DELIVERY_SESSION_SECRET=replace-with-a-long-random-secret

# Cashfree server-to-server webhook endpoint. In production this can be omitted
# when CASHFREE_SITE_URL is the public Website base URL. For local development,
# set this to a public HTTPS tunnel URL ending in /api/cashfree/webhook.
CASHFREE_WEBHOOK_URL=

# Cloudinary server-side photo deletion. Keep API secret server-only.
CLOUDINARY_CLOUD_NAME=df1j4s8cu
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Customer OTP authentication (SERVER ONLY; never expose these as NEXT_PUBLIC_ values)
CUSTOMER_OTP_DEMO_MODE=false
CUSTOMER_OTP_LENGTH=4
CUSTOMER_OTP_EXPIRY_SECONDS=120
SMS_API_URL=http://sms.bulkssms.com/submitsms.jsp
SMS_USER=seedlings
SMS_KEY=<SERVER_ONLY_SMS_KEY>
SMS_SENDER_ID=OTPSSS
SMS_ACCUSAGE=1
SMS_ENTITY_ID=1201159543060917386
SMS_TEMPLATE_ID=1207161729866691748

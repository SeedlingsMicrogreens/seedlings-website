NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seedlingsmicrogreenwebsite
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Demo OTP is development/test only. Keep disabled in production.
NEXT_PUBLIC_ENABLE_DEMO_OTP=false
# Set only in a local development/test environment when demo OTP is enabled.
# NEXT_PUBLIC_DEMO_OTP=1234

# Cashfree Payment Gateway - server-side test credentials. Never expose the secret to the browser.
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2026-01-01
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Optional: set this to a public HTTPS webhook endpoint when deployed.
CASHFREE_WEBHOOK_URL=
# Optional local/explicit Firebase Admin credentials. Firebase App Hosting can use Application Default Credentials.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Public website origin used in Cashfree return URLs. Defaults to the current request origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CASHFREE_ENVIRONMENT=sandbox

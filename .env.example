NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seedlingsmicrogreenwebsite
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Demo OTP is development/test only. Keep disabled in production.
NEXT_PUBLIC_ENABLE_DEMO_OTP=false
# Set only in a local development/test environment when demo OTP is enabled.
# NEXT_PUBLIC_DEMO_OTP=1234

# Cashfree Payment Gateway browser SDK mode only.
# Cashfree server credentials are stored in Firebase Functions Secret Manager.
NEXT_PUBLIC_CASHFREE_ENVIRONMENT=sandbox

# URL of the running Seedlings customer website.
E2E_BASE_URL=http://localhost:3000

# Dedicated test customer mobile. Do not use a real customer's account.
E2E_TEST_MOBILE=9999999999

# This suite creates one real order and one real subscription.
# Keep 0 unless you intentionally want to run the mutating journey.
E2E_ALLOW_MUTATIONS=0

# Optional: set to 1 only if you want Playwright to start Next.js itself.
# Leave unset/0 when the app is already running.
E2E_START_SERVER=0

# Development-only demo authentication for local E2E runs. Never enable this in production.
NEXT_PUBLIC_ENABLE_DEMO_OTP=true
NEXT_PUBLIC_DEMO_OTP=1234
E2E_TEST_OTP=1234

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownAuthUid(data) {
      return signedIn() && data.authUid == request.auth.uid;
    }

    function ownCustomer(data) {
      return signedIn()
        && data.customerId is string
        && exists(/databases/$(database)/documents/customers/$(data.customerId))
        && (
          get(/databases/$(database)/documents/customers/$(data.customerId)).data.authUid == request.auth.uid
          || (
            get(/databases/$(database)/documents/customers/$(data.customerId)).data.authUids is list
            && get(/databases/$(database)/documents/customers/$(data.customerId)).data.authUids.hasAny([request.auth.uid])
          )
        );
    }

    function profile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
        && profile().status == 'active'
        && profile().role in ['ADMIN', 'SUPER_ADMIN', 'OPERATIONS'];
    }

    function pendingOrder(data) {
      return data.paymentStatus == 'pending'
        && data.status == 'pending_payment';
    }

    function pendingSubscription(data) {
      return data.paymentStatus == 'pending'
        && data.status == 'pending_payment';
    }

    // Customer-facing catalogue/configuration is readable by signed-in customers.
    // Admin writes remain possible through Firebase Admin SDK/server processes.
    match /salesProducts/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /products/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /subscriptionPlans/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /geolocations/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /deliveryCharges/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /offers/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /growingBatches/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Customers are owned by the shared Firebase Auth identity used by Website and Mobile.
    match /customers/{mobile} {
      allow read: if signedIn() && (
        resource.data.authUid == request.auth.uid
        || (resource.data.authUids is list && resource.data.authUids.hasAny([request.auth.uid]))
      );
      allow create: if signedIn()
        && request.resource.data.mobile == mobile
        && request.resource.data.authUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.mobile == mobile
        && resource.data.authUid == request.auth.uid
        && request.resource.data.mobile == resource.data.mobile
        && request.resource.data.authUid == request.auth.uid;
      allow delete: if false;
    }

    // Customers may create only their own pending checkout records. They cannot
    // mark anything paid/confirmed, alter an existing payment, or delete orders.
    match /orders/{orderId} {
      allow read: if signedIn() && (ownAuthUid(resource.data) || ownCustomer(resource.data));
      allow create: if signedIn()
        && ownAuthUid(request.resource.data)
        && pendingOrder(request.resource.data)
        && request.resource.data.paymentStatus != 'paid'
        && request.resource.data.status != 'confirmed'
        && request.resource.data.status != 'active';
      allow update: if signedIn()
        && ownAuthUid(resource.data)
        && ownAuthUid(request.resource.data)
        && pendingOrder(resource.data)
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.status == 'pending_payment'
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.total == resource.data.total
        && request.resource.data.items == resource.data.items;
      allow delete: if false;
    }

    // Customers may submit feedback only for their own delivered order/delivery.
    // The document ID is intentionally not user-controlled for uniqueness; the
    // application checks for an existing feedback record before showing the form.
    match /orderFeedback/{feedbackId} {
      allow read: if signedIn() && (ownAuthUid(get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data) || ownCustomer(get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data));
      allow create: if signedIn()
        && request.resource.data.customerId == get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId
        && ownAuthUid(get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data)
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == 'delivered'
        && request.resource.data.orderId is string
        && request.resource.data.orderRating is int
        && request.resource.data.orderRating >= 1
        && request.resource.data.orderRating <= 5
        && request.resource.data.deliveryRating is int
        && request.resource.data.deliveryRating >= 1
        && request.resource.data.deliveryRating <= 5
        && (!('subscriptionDeliveryId' in request.resource.data) || request.resource.data.subscriptionDeliveryId == null || (request.resource.data.subscriptionDeliveryId is string && get(/databases/$(database)/documents/subscriptionDeliveries/$(request.resource.data.subscriptionDeliveryId)).data.orderId == request.resource.data.orderId && get(/databases/$(database)/documents/subscriptionDeliveries/$(request.resource.data.subscriptionDeliveryId)).data.status == 'delivered' && get(/databases/$(database)/documents/subscriptionDeliveries/$(request.resource.data.subscriptionDeliveryId)).data.customerId == request.resource.data.customerId));
      allow update, delete: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if signedIn() && (ownAuthUid(resource.data) || ownCustomer(resource.data));
      allow create: if signedIn()
        && ownAuthUid(request.resource.data)
        && pendingSubscription(request.resource.data)
        && request.resource.data.paymentStatus != 'paid'
        && request.resource.data.status != 'active';
      allow update: if signedIn()
        && ownAuthUid(resource.data)
        && ownAuthUid(request.resource.data)
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.customerId == resource.data.customerId
        && (
          (resource.data.paymentStatus == 'pending'
            && request.resource.data.paymentStatus == 'pending'
            && request.resource.data.status == 'pending_payment')
          ||
          (resource.data.paymentStatus == 'paid'
            && resource.data.status == 'active'
            && request.resource.data.paymentStatus == 'paid'
            && request.resource.data.status in ['active', 'paused', 'cancelled'])
        );
      allow delete: if false;
    }

    // Customer enquiries are separate from orders. A signed-in customer may
    // create an enquiry for their own session; the public contact form may also
    // create an enquiry without authentication. Enquiries are not orders and
    // cannot be updated or deleted by customers.
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.status == 'open'
        && request.resource.data.source in ['customer_checkout', 'contact_page']
        && request.resource.data.name is string
        && request.resource.data.productName is string
        && request.resource.data.message is string
        && request.resource.data.name.size() > 0
        && request.resource.data.productName.size() > 0
        && request.resource.data.message.size() > 0
        && (!signedIn() || request.resource.data.authUid == request.auth.uid);
      allow read: if signedIn() && (ownAuthUid(resource.data) || ownCustomer(resource.data));
      allow update, delete: if false;
    }

    // These are server-controlled financial/audit collections.
    match /paymentAttempts/{id} {
      allow read, write: if false;
    }
    match /paymentTransactions/{id} {
      allow read, write: if false;
    }
    match /paymentFinalizationLocks/{id} {
      allow read, write: if false;
    }
    match /paymentCreationLocks/{id} {
      allow read, write: if false;
    }


    // Customer notification records are server/admin-created. Customers may only
    // read and mark their own notifications as read. Recipient UID is the primary
    // ownership check; authUids on the customer record keeps older/admin-created
    // notifications addressable across the customer's browser sessions.
    match /notifications/{notificationId} {
      allow read: if admin() || (signedIn()
        && (
          resource.data.recipientUid == request.auth.uid
          || (
            resource.data.recipientCustomerId is string
            && exists(/databases/$(database)/documents/customers/$(resource.data.recipientCustomerId))
            && (
              get(/databases/$(database)/documents/customers/$(resource.data.recipientCustomerId)).data.authUid == request.auth.uid
              || (
                get(/databases/$(database)/documents/customers/$(resource.data.recipientCustomerId)).data.authUids is list
                && get(/databases/$(database)/documents/customers/$(resource.data.recipientCustomerId)).data.authUids.hasAny([request.auth.uid])
              )
            )
          )
        ));
      allow update: if admin() || (signedIn()
        && (
          resource.data.recipientUid == request.auth.uid
          || (
            resource.data.recipientCustomerId is string
            && exists(/databases/$(database)/documents/customers/$(resource.data.recipientCustomerId))
            && (
              get(/databases/$(database)/documents/customers/$(resource.data.recipientCustomerId)).data.authUid == request.auth.uid
              || (
                get(/databases/$(database)/documents/customers/$(resource.data.recipientCustomerId)).data.authUids is list
                && get(/databases/$(database)/documents/customers/$(resource.data.recipientCustomerId)).data.authUids.hasAny([request.auth.uid])
              )
            )
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']));
      allow create, delete: if false;
    }

    match /customerPushSubscriptions/{subscriptionId} {
      allow read: if admin() || (signedIn() && resource.data.authUid == request.auth.uid);
      allow create: if admin() || (signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.customerId is string
        && request.resource.data.token is string
        && request.resource.data.platform == 'web'
        && exists(/databases/$(database)/documents/customers/$(request.resource.data.customerId))
        && (
          get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.authUid == request.auth.uid
          || (
            get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.authUids is list
            && get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.authUids.hasAny([request.auth.uid])
          )
        ));
      allow update: if admin() || (signedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.token == resource.data.token
        && exists(/databases/$(database)/documents/customers/$(request.resource.data.customerId))
        && (
          get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.authUid == request.auth.uid
          || (
            get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.authUids is list
            && get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.authUids.hasAny([request.auth.uid])
          )
        ));
      allow delete: if admin() || (signedIn() && resource.data.authUid == request.auth.uid);
    }

    // Everything else is denied by default. Admin SDK is not subject to these rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
